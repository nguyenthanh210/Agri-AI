PROJECT_NAME=ICTU-OpenAgri
VERSION=1.0.0
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./ictu_openagri.db

# Security
SECRET_KEY=your-secret-key-change-in-production-please-use-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Sentinel / Copernicus
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
OUTPUT_DIR=./output
MAX_PRODUCTS=20

#ADMIN USER
ADMIN_EMAIL=admin@openagri.com
ADMIN_PASSWORD=admin123

# Google OAuth2 (for Google Sign-In)
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google Gemini AI
# Get a free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# FIWARE (optional, for IoT data integration)
ORION_URL=http://localhost:1026
QUANTUMLEAP_URL=http://localhost:8668
FIWARE_SERVICE=openagri
FIWARE_SERVICEPATH=/farms
FIWARE_ENABLED=true